{
  "expo": {
    "name": "IS Manager",
    "slug": "is-manager",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dbf59c29-bdcf-4465-9f3c-e4e73effc375"
    },
    "orientation": "portrait",
    "icon": "./src/assets/images/icon.png",
    "scheme": "ismanager",
    "userInterfaceStyle": "automatic",
    "locales": {
      "en": "./src/assets/ios-permissions/en.json",
      "uk": "./src/assets/ios-permissions/uk.json",
      "pl": "./src/assets/ios-permissions/pl.json",
      "lt": "./src/assets/ios-permissions/lt.json",
      "ru": "./src/assets/ios-permissions/ru.json",
      "de": "./src/assets/ios-permissions/de.json"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.isfleet.ismanager",
      "infoPlist": {
        "NSCameraUsageDescription": "The app needs camera access to take photos of documents and send them in chat.",
        "NSPhotoLibraryUsageDescription": "The app needs access to your photos to attach images to chats and documents and to set your profile picture.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "The app needs access to your photos to save pictures from chat to your gallery.",
        "NSMicrophoneUsageDescription": "The app needs microphone access to record voice messages in chat.",
        "CFBundleAllowMixedLocalizations": true
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "com.isfleet.ismanager",
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./src/assets/images/adaptive-icon-foreground.png",
        "monochromeImage": "./src/assets/images/adaptive-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_NOTIFICATION_POLICY"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A",
          "dark": {
            "backgroundColor": "#0F172A"
          }
        }
      ],
      "expo-secure-store",
      "expo-localization",
      [
        "expo-audio",
        {
          "microphonePermission": "The app needs microphone access to record voice messages in chat.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/assets/images/notification-icon.png",
          "color": "#3B82F6",
          "sounds": [
            "./src/assets/sounds/push_message.mp3",
            "./src/assets/sounds/is_alarm.mp3"
          ]
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "The app needs access to your photos to attach images to chats and documents and to set your profile picture.",
          "savePhotosPermission": "The app needs access to your photos to save pictures from chat to your gallery.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "organization": "dmytro-chaika",
          "project": "is-manager"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "API_URL": "https://api.isfleet.eu",
      "SENTRY_DSN": "https://f0e763f758a9bc1e3f1a7e4c57d1541a@o4512086189080576.ingest.de.sentry.io/4512347012530256",
      "eas": {
        "projectId": "dbf59c29-bdcf-4465-9f3c-e4e73effc375"
      }
    },
    "owner": "d-seadull"
  }
}
