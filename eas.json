{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "preview": {
      "channel": "preview",
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": {
        "SENTRY_ALLOW_FAILURE": "true",
        "EXPO_PUBLIC_API_URL": "https://api.isfleet.eu"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": {
        "SENTRY_ALLOW_FAILURE": "true",
        "EXPO_PUBLIC_API_URL": "https://api.isfleet.eu"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
